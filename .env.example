# Optional: Configure your preferred LLM provider.
# If no keys are provided, the toolkit automatically runs in deterministic Mock mode!

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Runtime settings
TOOLKIT_MODEL=gemini-1.5-flash
TOOLKIT_TEMPERATURE=0.7
